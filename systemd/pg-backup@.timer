[Unit]
Description=Nightly Postgres backup for %i

[Timer]
# The server clock is UTC, so this is 06:30 in Israel in summer, 05:30 in winter.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
# If the box was off at 03:30, run once at next boot instead of skipping the night.
Persistent=true

[Install]
WantedBy=timers.target
